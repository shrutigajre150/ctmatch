# Copy to .env and adjust. All settings are read from CTMATCH_* environment variables.
CTMATCH_DATABASE_URL=postgresql://ctmatch:ctmatch@localhost:5432/ctmatch
CTMATCH_CTGOV_BASE_URL=https://clinicaltrials.gov/api/v2
CTMATCH_CTGOV_PAGE_SIZE=1000
# Seconds between API requests. The API allows roughly 50 requests/minute per IP.
CTMATCH_CTGOV_MIN_INTERVAL_S=1.3
